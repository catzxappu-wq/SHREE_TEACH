{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/auth/login",
      "dest": "/api/auth/login.js"
    },
    {
      "src": "/api/settings",
      "dest": "/api/settings.js"
    },
    {
      "src": "/api/cloud/status",
      "dest": "/api/cloud/status.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
